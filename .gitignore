# ==========================================
# FossilSoloMCP - Exclusion rules for Git
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
env/
venv/
ENV/

# Fossil SCM local metadata and repositories
_FOSSIL_
*.fossil
*.fossil-journal
.fslckout

# RAM Disk archives and temporary development sessions
arh_r/

# IDE and AI assistant local configurations
.agents/
.gemini/
.idea/
.vscode/

# Internal local project kitchen / development notes (kept only in Fossil SCM)
JURNAL.md
doc/STARE_*.md
doc/GHID_AUTENTIFICARE_2FA.md
doc/RELEASE_NOTES_*_ro.md
ipoteze.md
specificatii.md
NOTE_TEHNICE.md
avantaje_mcp.md
mesaj_eroare.txt

# OS-generated files
.DS_Store
Thumbs.db
$RECYCLE.BIN/
System Volume Information/
